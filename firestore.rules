rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * ========================================================================
     * CYBER SHIELD - FIRESTORE SECURITY RULES
     * ========================================================================
     * 
     * WHY TEST MODE RULES (allow read, write: if true) ARE DANGEROUS:
     * 1. Total Data Leakage: Anyone on the internet could query and read all
     *    private user scan checks, exposing sensitive messages and personal
     *    inboxes being checked for fraud.
     * 2. Malicious Tampering: Attackers could overwrite existing checks, inject
     *    false "Looks Safe" verdicts for dangerous malware URLs, or wipe data.
     * 3. Database Spam & Denial of Service: Bad actors could flood the database
     *    with millions of junk documents, causing massive unexpected billing.
     */

    // Helper: Check if user is signed in (anonymous or permanent Google account)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if the user is the owner of this specific document path
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    /**
     * ========================================================================
     * 1. USER SCAN CHECKS: users/{uid}/checks/{checkId}
     * ========================================================================
     * Fields stored:
     * - inputSnippet (string): Truncated snippet of the URL or message scanned.
     * - verdict (string): 'safe', 'caution', or 'danger'.
     * - reasons (list): Array of plain-language explanation identifiers.
     * - language (string): Language active during check ('en', 'hi', 'te').
     * - checkedFor (string): Selected persona ('myself', 'family', 'community').
     * - createdAt (timestamp): Server timestamp when check was executed.
     * 
     * Rule logic:
     * - Only the authentic user matching {uid} can read and write their checks.
     * - Nobody else can read another user's scan history.
     */
    match /users/{uid}/checks/{checkId} {
      allow read, write: if isOwner(uid);
    }

    /**
     * ========================================================================
     * 2. SCAM REPORTS: reports/{reportId}
     * ========================================================================
     * Fields stored:
     * - text (string): Scammed message or link snippet reported by the user.
     * - verdict (string): Severity level ('danger' or 'caution').
     * - createdAt (timestamp): Timestamp when report was first submitted.
     * - confirmCount (number): Number of times users confirmed this scam (starts at 1).
     * 
     * Rule logic:
     * - Any authenticated user (including anonymous users) can READ reports to
     *   see emerging scams and threat statistics.
     * - DIRECT CLIENT WRITES ARE BLOCKED (`allow write: if false;`). Writes are
     *   strictly restricted to the Cloud Function (submitReport) via the Admin
     *   SDK. This prevents malicious clients from fabricating fake reports.
     */
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions Admin SDK can write
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
